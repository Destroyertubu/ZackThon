# Default is a fully playable, explicitly labelled original demonstration.
ZHIYE_MODE=demo
ZHIYE_DB=data/zhiye.sqlite3
ZHIYE_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
ZHIYE_SECURE_COOKIE=0
# Real data: set ZHIYE_MODE=live and keep this only on the server.
ZHIHU_ACCESS_SECRET=
ZHIHU_SEARCH_DAILY_LIMIT=5000
ZHIYE_GUEST_DAILY_LIMIT=80
# Persist successful searches in ZHIYE_DB; 0 means no automatic refresh.
# Set a positive number of seconds only to opt into refreshing older results.
ZHIYE_CACHE_SECONDS=0
# Approving an opt-in public anchor requires this nonempty server-side secret.
ZHIYE_ADMIN_TOKEN=
# Optional verified external command adapter; do not put secrets in command args.
ZHIYE_PROVIDER=http
ZHIHU_CLI_PATH=zhihu-cli
# Optional local schema mapping file after checking the downloaded official Skill.
ZHIHU_SCHEMA_FILE=
