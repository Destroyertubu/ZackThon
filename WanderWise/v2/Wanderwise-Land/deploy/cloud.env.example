# Copy to cloud.env on the server. Domain only: no scheme, port, or path.
WW_DOMAIN=your-domain.example
# Leave live services disabled until their credentials have been configured.
# Inject ZHIHU_ACCESS_SECRET using the server environment if needed.
ZHIHU_SEARCH_DAILY_BUDGET=1000
ZHIHU_AI_DAILY_BUDGET=50
WW_HOURLY_TASK_LIMIT=10
