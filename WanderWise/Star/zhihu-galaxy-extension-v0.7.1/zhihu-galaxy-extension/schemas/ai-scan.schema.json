{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI scan output v0.7",
  "type": "object",
  "required": [
    "repairs"
  ],
  "additionalProperties": false,
  "properties": {
    "repairs": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "terms",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "label": {
            "type": "string",
            "minLength": 2,
            "maxLength": 18
          },
          "terms": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 18
            }
          },
          "reason": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    }
  }
}
