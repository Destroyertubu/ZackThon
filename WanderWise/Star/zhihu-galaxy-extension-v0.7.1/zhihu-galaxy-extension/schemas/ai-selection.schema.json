{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI evidence selection output v0.7",
  "type": "object",
  "required": [
    "groups"
  ],
  "additionalProperties": false,
  "properties": {
    "groups": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "accepted"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "accepted": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "id",
                "snippet"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "snippet": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
