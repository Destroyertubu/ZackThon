{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zhihu Galaxy palette v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "palette"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "maxLength": 80
    },
    "palette": {
      "type": "object",
      "required": [
        "bg",
        "nebula",
        "keyword",
        "phenomenon",
        "answer",
        "ink",
        "trail"
      ],
      "additionalProperties": false,
      "properties": {
        "bg": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "nebula": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "keyword": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "phenomenon": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "answer": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "ink": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "trail": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    }
  }
}
